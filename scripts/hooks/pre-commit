#!/bin/sh
# EMG SAW graphify-freshness pre-commit hook.
# Enable once with:   git config core.hooksPath scripts/hooks
# Keeps graphify-out/ + agent_map.html in sync with the code being committed (HG8).
# Skips gracefully if graphify/python are unavailable.

if command -v graphify >/dev/null 2>&1; then
  echo "[pre-commit] graphify update ."
  graphify update . >/dev/null 2>&1 || echo "[pre-commit] graphify update failed (skipping)"
  if command -v python >/dev/null 2>&1 && [ -f scripts/agent_map.py ]; then
    python scripts/agent_map.py >/dev/null 2>&1 || true
  fi
  git add graphify-out 2>/dev/null || true
else
  echo "[pre-commit] graphify not found — skipping graph refresh"
fi
exit 0
